# ==============================================================================
# Konfigurasi Environment & API Keys
# ==============================================================================

# OpenAI API Key (atau provider LLM lainnya seperti Gemini / Groq)
OPENAI_API_KEY=your_openai_api_key_here

# Konfigurasi Model
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Konfigurasi Admin & Autentikasi
ADMIN_PASSWORD=admin123

# Konfigurasi Database & Penyimpanan
VECTOR_DB_PATH=./data/vector_db
RAW_PDF_PATH=./data/raw_pdfs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
